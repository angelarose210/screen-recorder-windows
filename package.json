{
  "name": "screen-recorder",
  "version": "0.1.0",
  "description": "Polished screen recorder with AI avatar integration",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json && node scripts/wait-for-vite.js && electron .",
    "build": "tsc -p tsconfig.node.json && vite build",
    "build:native": "cmake-js build --directory native --CDCMAKE_BUILD_TYPE=Release",
    "rebuild:native": "cmake-js rebuild --directory native --runtime electron --runtime-version 33.4.0 --arch x64",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "download-ffmpeg": "powershell -ExecutionPolicy Bypass -File scripts/download-ffmpeg.ps1",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "cmake-js": "^7.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  }
}

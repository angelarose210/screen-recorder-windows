{
  "appId": "com.screenrecorder.app",
  "productName": "Screen Recorder",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "native/build/screen_recorder_native.node",
    "resources/icon.ico",
    "resources/icon.png"
  ],
  "extraResources": [
    {
      "from": "resources/ffmpeg/ffmpeg.exe",
      "to": "ffmpeg/ffmpeg.exe"
    }
  ],
  "asarUnpack": [
    "native/build/*.node",
    "resources/icon.ico"
  ],
  "npmRebuild": false,
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "resources/icon.ico",
    "artifactName": "Screen-Recorder-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Screen Recorder",
    "deleteAppDataOnUninstall": false
  },
  "publish": [
    {
      "provider": "github",
      "owner": "angelarose210",
      "repo": "screen-recorder-windows",
      "releaseType": "release"
    }
  ]
}
{
  "appId": "com.screenrecorder.app",
  "productName": "Screen Recorder",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "native/build/screen_recorder_native.node",
    "resources/icon.ico",
    "resources/icon.png"
  ],
  "asarUnpack": [
    "native/build/*.node",
    "resources/icon.ico"
  ],
  "npmRebuild": false,
  "win": {
    "target": ["dir"],
    "icon": "resources/icon.ico"
  }
}
